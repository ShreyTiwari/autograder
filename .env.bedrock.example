# The Bedrock settings we run with. Copy this to .env.bedrock (gitignored),
# paste your Bedrock API key below, then:
#   source .env.bedrock && python main.py data/participation/2026-09-03.pdf
# Never put a real key in this file: it is committed.
export AWS_REGION='us-east-2'
export VISION_PROVIDER='bedrock'
export VISION_MODEL='qwen.qwen3-vl-235b-a22b'
export AWS_BEARER_TOKEN_BEDROCK='paste-your-bedrock-api-key-here'
